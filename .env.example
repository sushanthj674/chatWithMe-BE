# Copy to .env and point this at your Firebase Admin SDK service account key
# (Console -> Project settings -> Service accounts -> Generate new private key).
# If left unset, docker-compose mounts /dev/null in its place and the backend
# just runs with FCM pushes disabled.
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/absolute/path/to/service-account.json

# PostgreSQL connection (e.g. a Supabase project). Required — the app won't
# start without these. Never commit real values; this file only holds
# placeholders.
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=changeme
